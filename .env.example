# Copy this file to .env and supply local credentials. Do not commit .env.
APP_NAME=QR Management System
APP_HOST=127.0.0.1
APP_PORT=8080
APP_RELOAD=false

SUPABASE_URL=https://your-project.supabase.co
# Use a publishable (sb_publishable_...) key, or a legacy anon key if needed.
# Never place a secret/service-role key in this file.
SUPABASE_KEY=sb_publishable_your_key_here
